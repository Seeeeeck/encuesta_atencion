                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ids = JSON.parse(pm.collectionVariables.get('preguntaIds') || '[]').slice(1);",
                  "pm.collectionVariables.set('respuestasBody', JSON.stringify({ respuestas: ids.map(id => ({ id_pregunta: id, numero_respuesta: 3 })) }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
