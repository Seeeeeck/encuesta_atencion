              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ids = JSON.parse(pm.collectionVariables.get('preguntaIds') || '[]');",
                  "pm.collectionVariables.set('respuestasBody', JSON.stringify({ respuestas: ids.map(id => ({ id_pregunta: id, numero_respuesta: 6 })) }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));"
