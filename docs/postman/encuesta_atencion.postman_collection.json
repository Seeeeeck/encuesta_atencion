    {
      "name": "04 Firmados (manual)",
      "description": "Necesitan la firma que llega por mail. Correr a mano después de copiar los valores del log. Sin firma válida devuelven 403 (eso también sirve como prueba).",
      "item": [
        {
          "name": "Verificar correo (registro)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/email/verificar/{{verifId}}/{{verifHash}}?expires={{verifExpires}}&signature={{verifSignature}}",
            "description": "Valores del link \"Verificar correo\" del mail de registro (id, hash, expires, signature)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 si la firma es válida, 403 si no', () => pm.expect(pm.response.code).to.be.oneOf([200, 403]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar firma de cambio de correo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/me/actualizar/correo/verificacion/firma?{{firmaVerificacionQuery}}",
            "description": "Query del parámetro \"verificacion\" (URL decodificada) del mail de cambio de correo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 si la firma es válida, 403 si no', () => pm.expect(pm.response.code).to.be.oneOf([200, 403]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar correo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/me/actualizar/correo?{{firmaCambioCorreoQuery}}",
            "description": "id, hash, expires y signature del link \"Cambiar correo\".",
