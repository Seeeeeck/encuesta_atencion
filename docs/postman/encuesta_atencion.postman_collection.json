              }
            }
          ]
        },
        {
          "name": "Enviar encuesta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{usuarioToken}}"
              }
            ],
            "url": "{{baseUrl}}/encuesta/enviar",
            "description": "El body se arma solo con los ids de \"Obtener preguntas\" y respuestas al azar del 1 al 5.",
            "body": {
              "mode": "raw",
              "raw": "{{respuestasBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ids = JSON.parse(pm.collectionVariables.get('preguntaIds') || '[]');",
                  "const respuestas = ids.map(id => ({ id_pregunta: id, numero_respuesta: Math.floor(Math.random() * 5) + 1 }));",
                  "pm.collectionVariables.set('respuestasBody', JSON.stringify({ respuestas }, null, 2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
